@page
@model TallerMecanicoScrum.Pages.NuevaOrdenTrabajoModel

@{
    ViewData["Title"] = "Nueva Orden de Trabajo";
}

<div class="container-fluid">

    <!-- ENCABEZADO -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold mb-1">
                Nueva Orden de Trabajo
            </h2>

            <p class="text-muted mb-0">
                Registrar una nueva orden para un vehículo
            </p>
        </div>

        <div>

            <a
                asp-page="/OrdenesTrabajo"
                class="btn btn-outline-secondary">

                <i class="bi bi-arrow-left me-1"></i>
                Volver

            </a>

        </div>

    </div>


    <!-- FORMULARIO -->
    <div class="card shadow-sm border-0">

        <div class="card-body p-4">

            <form method="post">

                <!-- VEHÍCULO -->
                <div class="mb-4">

                    <label
                        asp-for="EntidadOrden.VehiculoId"
                        class="form-label fw-semibold">

                        Vehículo

                    </label>

                    <select
                        asp-for="EntidadOrden.VehiculoId"
                        class="form-select">

                        <option value="0">
                            -- Seleccione un vehículo --
                        </option>

                        @foreach (var vehiculo in Model.ListaVehiculos)
                        {
                            <option value="@vehiculo.Id">

                                @vehiculo.Placa -
                                @vehiculo.Marca
                                @vehiculo.Modelo -
                                @vehiculo.Cliente

                            </option>
                        }

                    </select>

                    <span
                        asp-validation-for="EntidadOrden.VehiculoId"
                        class="text-danger">
                    </span>

                </div>


                <div class="row">

                    <!-- FECHA ENTREGA -->
                    <div class="col-md-6 mb-4">

                        <label
                            asp-for="EntidadOrden.FechaEntregaEstimada"
                            class="form-label fw-semibold">

                            Fecha estimada de entrega

                        </label>

                        <input
                            asp-for="EntidadOrden.FechaEntregaEstimada"
                            type="datetime-local"
                            class="form-control" />

                        <span
                            asp-validation-for="EntidadOrden.FechaEntregaEstimada"
                            class="text-danger">
                        </span>

                    </div>


                    <!-- ESTADO -->
                    <div class="col-md-6 mb-4">

                        <label class="form-label fw-semibold">
                            Estado inicial
                        </label>

                        <input
                            type="text"
                            class="form-control"
                            value="Recibido"
                            readonly />

                        <div class="form-text">
                            Toda nueva orden comienza en estado recibido.
                        </div>

                    </div>

                </div>


                <!-- DIAGNÓSTICO -->
                <div class="mb-4">

                    <label
                        asp-for="EntidadOrden.Diagnostico"
                        class="form-label fw-semibold">

                        Diagnóstico

                    </label>

                    <textarea
                        asp-for="EntidadOrden.Diagnostico"
                        class="form-control"
                        rows="5"
                        placeholder="Ingrese el diagnóstico o problema reportado por el cliente...">
                    </textarea>

                    <span
                        asp-validation-for="EntidadOrden.Diagnostico"
                        class="text-danger">
                    </span>

                </div>


                <!-- BOTONES -->
                <div class="d-flex justify-content-end gap-2">

                    <a
                        asp-page="/OrdenesTrabajo"
                        class="btn btn-secondary">

                        Cancelar

                    </a>

                    <button
                        type="submit"
                        class="btn btn-primary">

                        <i class="bi bi-save me-1"></i>
                        Crear Orden

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />

}