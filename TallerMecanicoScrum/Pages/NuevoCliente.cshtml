@page
@model TallerMecanicoScrum.Pages.NuevoClienteModel

@{
    ViewData["Title"] = "Nuevo Cliente";
}

<div class="container-fluid">

    <div class="mb-4">
        <h2 class="fw-bold mb-1">
            Nuevo Cliente
        </h2>

        <p class="text-muted mb-0">
            Registrar un nuevo cliente
        </p>
    </div>

    <div class="card shadow-sm border-0">

        <div class="card-body">

            <form method="post">

                <div class="row g-3">

                    <div class="col-md-6">
                        <label class="form-label">
                            Nombre
                        </label>

                        <input asp-for="Cliente.Nombre"
                               class="form-control"
                               placeholder="Ej. Juan" />

                        <span asp-validation-for="Cliente.Nombre" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">
                            Apellido
                        </label>

                        <input asp-for="Cliente.Apellido"
                               class="form-control"
                               placeholder="Ej. Pérez" />

                        <span asp-validation-for="Cliente.Apellido" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">
                            CI/NIT
                        </label>

                        <input asp-for="Cliente.CiNit"
                               class="form-control"
                               placeholder="Ej. 1234567" />

                        <span asp-validation-for="Cliente.CiNit" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">
                            Teléfono
                        </label>

                        <input asp-for="Cliente.Telefono"
                               class="form-control"
                               placeholder="Ej. 70707070" />

                        <span asp-validation-for="Cliente.Telefono" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">
                            Email
                        </label>

                        <input asp-for="Cliente.Email"
                               type="email"
                               class="form-control"
                               placeholder="Ej. juan@gmail.com" />

                        <span asp-validation-for="Cliente.Email" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">
                            Dirección
                        </label>

                        <input asp-for="Cliente.Direccion"
                               class="form-control"
                               placeholder="Ej. Av. América #123" />

                        <span asp-validation-for="Cliente.Direccion" class="text-danger small"></span>
                    </div>

                </div>

                <hr class="my-4" />

                <div class="d-flex justify-content-end gap-2">

                    <a asp-page="/Clientes"
                       class="btn btn-secondary">
                        Cancelar
                    </a>

                    <button type="submit"
                            class="btn btn-primary">

                        <i class="bi bi-save me-1"></i>
                        Guardar Cliente

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>