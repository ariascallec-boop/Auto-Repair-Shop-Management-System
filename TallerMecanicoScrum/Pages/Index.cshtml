@page
@model IndexModel

@{
    ViewData["Title"] = "Inicio";
}

<div class="container-fluid">

    <!-- TITULO -->

    <div class="mb-4">

        <h2 class="fw-bold">
            Panel Principal
        </h2>

        <p class="text-muted">
            Resumen del estado actual de los vehículos del taller
        </p>

    </div>


    <!-- TARJETAS -->

    <div class="row g-3 mb-4">

        <!-- VEHICULOS EN TALLER -->

        <div class="col-md-3">

            <div class="card shadow-sm border-0 h-100">

                <div class="card-body d-flex align-items-center gap-3">

                    <div class="dashboard-icon bg-primary-subtle text-primary">

                        <i class="bi bi-car-front-fill"></i>

                    </div>

                    <div>

                        <small class="text-muted">
                            Vehículos en taller
                        </small>

                        <h2 class="fw-bold mb-0">
                            @Model.Vehiculos.Count
                        </h2>

                    </div>

                </div>

            </div>

        </div>


        <!-- EN REPARACION -->

        <div class="col-md-3">

            <div class="card shadow-sm border-0 h-100">

                <div class="card-body d-flex align-items-center gap-3">

                    <div class="dashboard-icon bg-warning-subtle text-warning">

                        <i class="bi bi-tools"></i>

                    </div>

                    <div>

                        <small class="text-muted">
                            En reparación
                        </small>

                        <h2 class="fw-bold mb-0">

                            @Model.Vehiculos.Count(v => v.Estado == "En reparación")

                        </h2>

                    </div>

                </div>

            </div>

        </div>


        <!-- LISTOS -->

        <div class="col-md-3">

            <div class="card shadow-sm border-0 h-100">

                <div class="card-body d-flex align-items-center gap-3">

                    <div class="dashboard-icon bg-success-subtle text-success">

                        <i class="bi bi-check-circle-fill"></i>

                    </div>

                    <div>

                        <small class="text-muted">
                            Listos para entregar
                        </small>

                        <h2 class="fw-bold mb-0">

                            @Model.Vehiculos.Count(v => v.Estado == "Listo")

                        </h2>

                    </div>

                </div>

            </div>

        </div>


        <!-- ENTREGAS -->

        <div class="col-md-3">

            <div class="card shadow-sm border-0 h-100">

                <div class="card-body d-flex align-items-center gap-3">

                    <div class="dashboard-icon bg-danger-subtle text-danger">

                        <i class="bi bi-calendar-check-fill"></i>

                    </div>

                    <div>

                        <small class="text-muted">
                            Entregas de hoy
                        </small>

                        <h2 class="fw-bold mb-0">

                            @Model.Vehiculos.Count

                        </h2>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- TABLA -->

    <div class="card shadow-sm border-0">

        <div class="card-header bg-white">

            <div class="d-flex justify-content-between align-items-center">

                <div>

                    <h5 class="fw-bold mb-0">
                        Estado actual de vehículos
                    </h5>

                    <small class="text-muted">
                        Estado actual y responsable
                    </small>

                </div>


                <span class="badge bg-primary">

                    @DateTime.Now.ToString("dd/MM/yyyy")

                </span>

            </div>

        </div>


        <div class="card-body">

            <div class="table-responsive">

                <table class="table table-hover align-middle">

                    <thead class="table-light">

                        <tr>

                            <th>Placa</th>
                            <th>Cliente</th>
                            <th>Vehículo</th>
                            <th>Estado</th>
                            <th>Responsable</th>
                            <th>Entrega</th>

                        </tr>

                    </thead>


                    <tbody>

                        @for (int i = 0; i < Model.Vehiculos.Count; i++)
                        {
                            <tr>

                                <td class="fw-semibold">

                                    @Model.Vehiculos[i].Placa

                                </td>


                                <td>

                                    @Model.Vehiculos[i].Cliente

                                </td>


                                <td>

                                    @Model.Vehiculos[i].Vehiculo

                                </td>


                                <td>

                                    @if (Model.Vehiculos[i].Estado == "Listo")
                                    {
                                        <span class="badge bg-success">
                                            @Model.Vehiculos[i].Estado
                                        </span>
                                    }
                                    else if (Model.Vehiculos[i].Estado == "En reparación")
                                    {
                                        <span class="badge bg-warning text-dark">
                                            @Model.Vehiculos[i].Estado
                                        </span>
                                    }
                                    else if (Model.Vehiculos[i].Estado == "En prueba")
                                    {
                                        <span class="badge bg-info text-dark">
                                            @Model.Vehiculos[i].Estado
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">
                                            @Model.Vehiculos[i].Estado
                                        </span>
                                    }

                                </td>


                                <td>

                                    @Model.Vehiculos[i].Responsable

                                </td>


                                <td>

                                    @Model.Vehiculos[i].HoraEntrega

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>