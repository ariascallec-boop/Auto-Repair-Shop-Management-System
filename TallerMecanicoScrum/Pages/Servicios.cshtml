@page
@model TallerMecanicoScrum.Pages.ServiciosModel

@{
    ViewData["Title"] = "Servicios";
}

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold mb-1">
                Servicios
            </h2>

            <p class="text-muted mb-0">
                Servicios disponibles en el taller
            </p>
        </div>

        <a asp-page="/NuevoServicio"
           class="btn btn-primary">

            <i class="bi bi-plus-circle me-1"></i>
            Nuevo Servicio

        </a>

    </div>

    <div class="card shadow-sm border-0">

        <div class="card-body">

            <form method="get"
                  class="row mb-3">

                <div class="col-md-6">

                    <div class="input-group">

                        <span class="input-group-text">
                            <i class="bi bi-search"></i>
                        </span>

                        <input type="text"
                               name="buscar"
                               value="@Model.Buscar"
                               class="form-control"
                               placeholder="Buscar por nombre o tipo..." />

                        <button type="submit"
                                class="btn btn-primary">

                            Buscar

                        </button>

                    </div>

                </div>

            </form>

            <div class="table-responsive">

                <table class="table table-hover align-middle">

                    <thead class="table-light">

                        <tr>
                            <th>N°</th>
                            <th>Nombre</th>
                            <th>Tipo</th>
                            <th>Descripción</th>
                            <th>Precio</th>
                            <th>Duración</th>
                            <th>Estado</th>
                            <th>Acciones</th>
                        </tr>

                    </thead>

                    <tbody>

                        @for (int i = 0; i < Model.ListaServicios.Count; i++)
                        {
                            <tr>

                                <td>
                                    @(i + 1)
                                </td>

                                <td class="fw-semibold">
                                    @Model.ListaServicios[i].Nombre
                                </td>

                                <td>

                                    @if (Model.ListaServicios[i].Tipo == "preventivo")
                                    {
                                        <span class="badge bg-primary">
                                            Preventivo
                                        </span>
                                    }
                                    else if (Model.ListaServicios[i].Tipo == "correctivo")
                                    {
                                        <span class="badge bg-warning text-dark">
                                            Correctivo
                                        </span>
                                    }
                                    else if (Model.ListaServicios[i].Tipo == "revision_simple")
                                    {
                                        <span class="badge bg-info text-dark">
                                            Revisión simple
                                        </span>
                                    }

                                </td>

                                <td>
                                    @Model.ListaServicios[i].Descripcion
                                </td>

                                <td>
                                    Bs @Model.ListaServicios[i].Precio
                                </td>

                                <td>
                                    @Model.ListaServicios[i].DuracionEstimada
                                    @Model.ListaServicios[i].UnidadDuracion
                                </td>

                                <td>

                                    @if (Model.ListaServicios[i].Estado)
                                    {
                                        <span class="badge bg-success">
                                            Activo
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">
                                            Inactivo
                                        </span>
                                    }

                                </td>

                                <td>

                                    <a asp-page="/EditarServicio"
                                       asp-route-id="@Model.ListaServicios[i].Id"
                                       class="btn btn-sm btn-warning">

                                        <i class="bi bi-pencil"></i>
                                        Editar

                                    </a>

                                    <button type="button"
                                            class="btn btn-sm btn-danger"
                                            data-bs-toggle="modal"
                                            data-bs-target="#modalEliminarServicio-@Model.ListaServicios[i].Id">

                                        <i class="bi bi-trash"></i>
                                        Eliminar

                                    </button>

                                    <div class="modal fade"
                                         id="modalEliminarServicio-@Model.ListaServicios[i].Id"
                                         tabindex="-1"
                                         aria-hidden="true">

                                        <div class="modal-dialog modal-dialog-centered">

                                            <div class="modal-content">

                                                <div class="modal-header">

                                                    <h5 class="modal-title">
                                                        Confirmar eliminación
                                                    </h5>

                                                    <button type="button"
                                                            class="btn-close"
                                                            data-bs-dismiss="modal">
                                                    </button>

                                                </div>

                                                <div class="modal-body">

                                                    ¿Está seguro que desea eliminar el servicio:

                                                    <strong>
                                                        @Model.ListaServicios[i].Nombre
                                                    </strong>?

                                                </div>

                                                <div class="modal-footer">

                                                    <button type="button"
                                                            class="btn btn-secondary"
                                                            data-bs-dismiss="modal">

                                                        Cancelar

                                                    </button>

                                                    <form method="post"
                                                          asp-page-handler="Eliminar">

                                                        <input type="hidden"
                                                               name="id"
                                                               value="@Model.ListaServicios[i].Id" />

                                                        <button type="submit"
                                                                class="btn btn-danger">

                                                            Eliminar

                                                        </button>

                                                    </form>

                                                </div>

                                            </div>

                                        </div>

                                    </div>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>