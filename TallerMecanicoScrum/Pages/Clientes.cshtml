@page
@model TallerMecanicoScrum.Pages.ClientesModel
@{
}
<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold mb-1">
                Clientes
            </h2>

            <p class="text-muted mb-0">
                Registro de clientes del taller
            </p>
        </div>

        <a asp-page="/NuevoCliente"
           class="btn btn-primary">

            <i class="bi bi-person-plus me-1"></i>
            Nuevo Cliente

        </a>

    </div>


    <div class="card shadow-sm border-0">

        <div class="card-body">

            <form method="get"
                  class="row mb-3">

                <div class="col-md-6">

                    <div class="input-group">

                        <span class="input-group-text">
                            <i class="bi bi-search"></i>
                        </span>

                        <input type="text"
                               name="buscar"
                               value="@Model.Buscar"
                               class="form-control"
                               placeholder="Buscar por nombre, apellido o CI/NIT..." />

                        <button type="submit"
                                class="btn btn-primary">

                            Buscar

                        </button>

                    </div>

                </div>

            </form>


            <div class="table-responsive">

                <table class="table table-hover align-middle">

                    <thead class="table-light">

                        <tr>
                            <th>N°</th>
                            <th>CI/NIT</th>
                            <th>Nombre</th>
                            <th>Apellido</th>
                            <th>Teléfono</th>
                            <th>Dirección</th>
                            <th>Estado</th>
                            <th>Acciones</th>
                        </tr>

                    </thead>


                    <tbody>

                        @for (int i = 0; i < Model.ListaClientes.Count; i++)
                        {
                            <tr>

                                <td>
                                    @(i + 1)
                                </td>

                                <td class="fw-semibold">
                                    @Model.ListaClientes[i].CiNit
                                </td>

                                <td>
                                    @Model.ListaClientes[i].Nombre
                                </td>

                                <td>
                                    @Model.ListaClientes[i].Apellido
                                </td>

                                <td>
                                    @Model.ListaClientes[i].Telefono
                                </td>

                                <td>
                                    @Model.ListaClientes[i].Direccion
                                </td>

                                <td>

                                    @if (Model.ListaClientes[i].Estado)
                                    {
                                        <span class="badge bg-success">
                                            Activo
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">
                                            Inactivo
                                        </span>
                                    }

                                </td>

                                <td>

                                    <a asp-page="/EditarCliente"
                                       asp-route-id="@Model.ListaClientes[i].Id"
                                       class="btn btn-sm btn-warning">

                                        <i class="bi bi-pencil"></i>
                                        Editar

                                    </a>


                                    <button type="button"
                                            class="btn btn-sm btn-danger"
                                            data-bs-toggle="modal"
                                            data-bs-target="#modalEliminarCliente-@Model.ListaClientes[i].Id">

                                        <i class="bi bi-trash"></i>
                                        Eliminar
                                    </button>
                                    <div class="modal fade"
                                         id="modalEliminarCliente-@Model.ListaClientes[i].Id"
                                         tabindex="-1"
                                         aria-hidden="true">

                                        <div class="modal-dialog modal-dialog-centered">

                                            <div class="modal-content">

                                                <div class="modal-header">

                                                    <h5 class="modal-title">
                                                        Confirmar eliminación
                                                    </h5>

                                                    <button type="button"
                                                            class="btn-close"
                                                            data-bs-dismiss="modal">
                                                    </button>

                                                </div>

                                                <div class="modal-body">

                                                    ¿Está seguro que desea eliminar al cliente:

                                                    <strong>
                                                        @Model.ListaClientes[i].Nombre
                                                        @Model.ListaClientes[i].Apellido
                                                    </strong>?

                                                </div>

                                                <div class="modal-footer">

                                                    <button type="button"
                                                            class="btn btn-secondary"
                                                            data-bs-dismiss="modal">

                                                        Cancelar

                                                    </button>

                                                    <form method="post"
                                                          asp-page-handler="Eliminar">

                                                        <input type="hidden"
                                                               name="id"
                                                               value="@Model.ListaClientes[i].Id" />

                                                        <button type="submit"
                                                                class="btn btn-danger">

                                                            Eliminar

                                                        </button>

                                                    </form>

                                                </div>

                                            </div>

                                        </div>

                                    </div>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>
