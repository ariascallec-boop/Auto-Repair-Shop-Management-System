@page
@model TallerMecanicoScrum.Pages.NuevoVehiculoModel

@{
    ViewData["Title"] = "Nuevo Vehículo";
}

<div class="container-fluid">

    <div class="mb-4">
        <h2 class="fw-bold mb-1">
            Nuevo Vehículo
        </h2>

        <p class="text-muted mb-0">
            Registrar un nuevo vehículo en el sistema
        </p>
    </div>

    <div class="card shadow-sm border-0">

        <div class="card-body">

            <form method="post">

                <div class="row g-3">

                    <div class="col-md-6">

                        <label class="form-label">
                            Placa
                        </label>

                        <input asp-for="Vehiculo.Placa"
                               class="form-control"
                               placeholder="Ej. 1234ABC" />

                    </div>

                    <div class="col-md-6">

                        <label class="form-label">
                            Marca
                        </label>

                        <input asp-for="Vehiculo.Marca"
                               class="form-control"
                               placeholder="Ej. Toyota" />

                    </div>

                    <div class="col-md-6">

                        <label class="form-label">
                            Modelo
                        </label>

                        <input asp-for="Vehiculo.Modelo"
                               class="form-control"
                               placeholder="Ej. Corolla" />

                    </div>

                    <div class="col-md-6">

                        <label class="form-label">
                            Año
                        </label>

                        <input asp-for="Vehiculo.Anio"
                               type="number"
                               class="form-control"
                               placeholder="Ej. 2020" />

                    </div>

                    <div class="col-md-6">

                        <label class="form-label">
                            Color
                        </label>

                        <input asp-for="Vehiculo.Color"
                               class="form-control"
                               placeholder="Ej. Blanco" />

                    </div>

                    <div class="col-md-6">

                        <label class="form-label">
                            Tipo
                        </label>

                        <select asp-for="Vehiculo.Tipo"
                                class="form-select">

                            <option value="">
                                Seleccione un tipo
                            </option>

                            <option value="Sedán">
                                Sedán
                            </option>

                            <option value="SUV">
                                SUV
                            </option>

                            <option value="Camioneta">
                                Camioneta
                            </option>

                            <option value="Hatchback">
                                Hatchback
                            </option>

                            <option value="Van">
                                Van
                            </option>

                        </select>

                    </div>

                    <div class="col-md-6">

                        <label class="form-label">
                            Kilometraje
                        </label>

                        <input asp-for="Vehiculo.Kilometraje"
                               type="number"
                               class="form-control"
                               placeholder="Ej. 85000" />

                    </div>

                    <div class="col-md-6">

                        <label class="form-label">
                            Cliente
                        </label>

                        <select asp-for="Vehiculo.ClienteId"
                                class="form-select">

                            <option value="">
                                Seleccione un cliente
                            </option>

                            <option value="1">
                                Juan Pérez
                            </option>

                            <option value="2">
                                María Gómez
                            </option>

                            <option value="3">
                                Pedro Sánchez
                            </option>

                        </select>

                    </div>

                </div>

                <hr class="my-4" />

                <div class="d-flex justify-content-end gap-2">

                    <a asp-page="/Vehiculos"
                       class="btn btn-secondary">

                        Cancelar

                    </a>

                    <button type="submit"
                            class="btn btn-primary">

                        <i class="bi bi-save me-1"></i>
                        Guardar Vehículo

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>