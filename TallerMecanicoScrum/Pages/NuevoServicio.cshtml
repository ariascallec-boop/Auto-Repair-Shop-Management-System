@page
@model TallerMecanicoScrum.Pages.NuevoServicioModel

@{
    ViewData["Title"] = "Nuevo Servicio";
}

<div class="container-fluid">

    <div class="mb-4">
        <h2 class="fw-bold mb-1">
            Nuevo Servicio
        </h2>

        <p class="text-muted mb-0">
            Registrar un nuevo servicio del taller
        </p>
    </div>

    <div class="card shadow-sm border-0">

        <div class="card-body">

            <form method="post">

                <div class="row g-3">

                    <div class="col-md-6">

                        <label class="form-label">
                            Nombre
                        </label>

                        <input asp-for="Servicio.Nombre"
                               class="form-control"
                               placeholder="Ej. Cambio de aceite" />

                    </div>

                    <div class="col-md-6">

                        <label class="form-label">
                            Tipo
                        </label>

                        <select asp-for="Servicio.Tipo"
                                class="form-select">

                            <option value="">
                                Seleccione un tipo
                            </option>

                            <option value="preventivo">
                                Preventivo
                            </option>

                            <option value="correctivo">
                                Correctivo
                            </option>

                            <option value="revision_simple">
                                Revisión simple
                            </option>

                        </select>

                    </div>

                    <div class="col-md-12">

                        <label class="form-label">
                            Descripción
                        </label>

                        <textarea asp-for="Servicio.Descripcion"
                                  class="form-control"
                                  rows="3"
                                  placeholder="Describa el servicio"></textarea>

                    </div>

                    <div class="col-md-4">

                        <label class="form-label">
                            Precio
                        </label>

                        <div class="input-group">

                            <span class="input-group-text">
                                Bs
                            </span>

                            <input asp-for="Servicio.Precio"
                                   type="number"
                                   step="0.01"
                                   class="form-control"
                                   placeholder="0.00" />

                        </div>

                    </div>

                    <div class="col-md-4">

                        <label class="form-label">
                            Duración estimada
                        </label>

                        <input asp-for="Servicio.DuracionEstimada"
                               type="number"
                               class="form-control"
                               placeholder="Ej. 2" />

                    </div>

                    <div class="col-md-4">

                        <label class="form-label">
                            Unidad
                        </label>

                        <select asp-for="Servicio.UnidadDuracion"
                                class="form-select">

                            <option value="">
                                Seleccione
                            </option>

                            <option value="Minutos">
                                Minutos
                            </option>

                            <option value="Horas">
                                Horas
                            </option>

                            <option value="Dias">
                                Días
                            </option>

                        </select>

                    </div>

                </div>

                <hr class="my-4" />

                <div class="d-flex justify-content-end gap-2">

                    <a asp-page="/Servicios"
                       class="btn btn-secondary">

                        Cancelar

                    </a>

                    <button type="submit"
                            class="btn btn-primary">

                        <i class="bi bi-save me-1"></i>
                        Guardar Servicio

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>